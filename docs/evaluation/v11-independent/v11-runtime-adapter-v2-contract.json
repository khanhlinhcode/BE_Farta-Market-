  "multi_intent_rule": "Each typed branch is normalized with its own runtime observation. Parent state never supplies a branch mutation target.",
  "follow_up_rule": "A context-resolved mutation target must equal the target on the typed Phase 15 route frame; unresolved context remains null.",
  "determinism": {
