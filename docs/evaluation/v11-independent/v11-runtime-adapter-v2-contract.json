      },
      "order-guide-vi": {
        "authority": "Published knowledge registry",
        "version": 2
      },
      "payment-guide-vi": {
        "authority": "Published knowledge registry",
        "version": 2
      },
      "policy-index-vi": {
        "authority": "Published knowledge registry",
        "version": 1
      },
      "shopping-guide-vi": {
        "authority": "Published knowledge registry",
        "version": 2
      },
      "owned-order-authority-v11-r1": {
        "authority": "Owned/private order authority (synthetic V11 R1)",
        "version": 1
      }
    }
  },
  "normalized_observation_fields": [
