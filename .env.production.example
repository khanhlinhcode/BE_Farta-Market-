APP_NAME="Farta Market API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-api-domain.com
FRONTEND_URL=https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-admin-domain.com
SECURITY_CSP="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://res.cloudinary.com; connect-src 'self' https://your-api-domain.com https://challenges.cloudflare.com; font-src 'self'; frame-src https://challenges.cloudflare.com"
SECURITY_HSTS_MAX_AGE=31536000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_TOKEN_EXPIRATION=60
SANCTUM_STATEFUL_DOMAINS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=120
CACHE_STORE=database

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_TOKEN_TTL_MINUTES=30
ANALYTICS_ALLOWED_ORIGINS=https://your-frontend-domain.com
TURNSTILE_REQUIRED=true
TURNSTILE_SITE_KEY=replace-with-site-key
TURNSTILE_SECRET_KEY=replace-with-secret-key
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
GUEST_ORDER_TTL_MINUTES=120
ADMIN_LOGIN_IP_LIMIT=5
ADMIN_LOGIN_ACCOUNT_LIMIT=5
MFA_CHALLENGE_IP_LIMIT=5
MFA_CHALLENGE_SESSION_LIMIT=5

REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Farta Market"

AI_CHAT_DRIVER=groq
AI_CHAT_MODEL=openai/gpt-oss-20b
AI_CHAT_BASE_URL=https://api.groq.com/openai/v1
AI_CHAT_TIMEOUT=15
AI_CHAT_KEEP_ALIVE=30m
GROQ_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_API_URL=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_RETURN_URL=
