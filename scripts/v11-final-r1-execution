#!/usr/bin/env bash
set -euo pipefail

required_authorization="RUN_FROZEN_V11_R1_REPLACEMENT_ONCE"
if [[ "${V11_FINAL_R1_EXECUTION_AUTHORIZATION:-}" != "${required_authorization}" ]]; then
  echo "Refusing replacement execution: exact V11 Final R1 authorization is required." >&2
  exit 64
fi

if [[ "${V11_EXECUTE:-0}" != "0" || "${V11_ALLOW_REQUESTS:-0}" != "0" ]]; then
  echo "Refusing replacement execution: legacy execution flags are not accepted." >&2
  exit 64
fi

export AI_CHAT_KNOWLEDGE_GENERATION_ENABLED=false
export AI_CHAT_QUERY_EXPANSION_ENABLED=false
export AI_CHAT_VECTOR_SEARCH_ENABLED=false
export AI_CHAT_QDRANT_INFERENCE_ENABLED=false

php artisan test tests/Feature/FinalV11ReplacementExecutionR1Test.php --compact
